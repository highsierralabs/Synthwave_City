{
  "name": "synthwave-city",
  "version": "0.1.0",
  "private": true,
  "description": "An endless 80s synthwave megacity you fly through in the browser. No asset files.",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:task": "node scripts/check-task.mjs",
    "plans:check": "node scripts/plans-check.mjs",
    "shot": "node scripts/shot.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "postprocessing": "6.39.6",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
